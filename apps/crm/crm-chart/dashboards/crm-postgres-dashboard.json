{
  "title": "CRM Database (PostgreSQL)",
  "uid": "crm-postgres-dashboard",
  "tags": ["crm", "postgresql"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "pg_stat_database_numbackends{job=\"crm-postgres\", datname=\"crmdb\"}", "legendFormat": "active connections" }
      ]
    },
    {
      "id": 2,
      "title": "Transaction Rate (commits/rollbacks per sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{job=\"crm-postgres\", datname=\"crmdb\"}[1m])", "legendFormat": "commits/sec" },
        { "expr": "rate(pg_stat_database_xact_rollback{job=\"crm-postgres\", datname=\"crmdb\"}[1m])", "legendFormat": "rollbacks/sec" }
      ]
    },
    {
      "id": 3,
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_blks_hit{job=\"crm-postgres\", datname=\"crmdb\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{job=\"crm-postgres\", datname=\"crmdb\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"crm-postgres\", datname=\"crmdb\"}[5m])))", "legendFormat": "cache hit ratio" }
      ]
    },
    {
      "id": 4,
      "title": "Database Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "pg_database_size_bytes{datname=\"crmdb\"}", "legendFormat": "crmdb size (bytes)" }
      ]
    },
    {
      "id": 5,
      "title": "Rows Fetched / Inserted / Updated / Deleted",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_fetched{job=\"crm-postgres\", datname=\"crmdb\"}[1m])", "legendFormat": "fetched/sec" },
        { "expr": "rate(pg_stat_database_tup_inserted{job=\"crm-postgres\", datname=\"crmdb\"}[1m])", "legendFormat": "inserted/sec" },
        { "expr": "rate(pg_stat_database_tup_updated{job=\"crm-postgres\", datname=\"crmdb\"}[1m])", "legendFormat": "updated/sec" },
        { "expr": "rate(pg_stat_database_tup_deleted{job=\"crm-postgres\", datname=\"crmdb\"}[1m])", "legendFormat": "deleted/sec" }
      ]
    },
    {
      "id": 6,
      "title": "Postgres Up",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "pg_up{job=\"crm-postgres\"}", "legendFormat": "up" }
      ]
    }
  ]
}
